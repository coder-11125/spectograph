#!/usr/bin/env bash
# Runs `cargo fmt` before each commit and re-stages any files it reformats.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found on PATH, skipping cargo fmt" >&2
    exit 0
fi

# Files staged for this commit, captured before formatting touches anything.
staged_files=$(git diff --name-only --cached --diff-filter=ACMR -- '*.rs')

if [ -z "$staged_files" ]; then
    exit 0
fi

echo "pre-commit: running cargo fmt..."
cargo fmt --all

# Re-stage only the files that were part of this commit, so fmt's changes
# to unrelated/unstaged files are left alone.
while IFS= read -r file; do
    [ -f "$file" ] && git add "$file"
done <<< "$staged_files"
